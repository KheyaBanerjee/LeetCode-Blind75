# Problem link: https://leetcode.com/problems/merge-two-sorted-lists/
# Difficulty: Easy

# Problem statement:
# You are given the heads of two sorted linked lists list1 and list2.
# Merge the two lists into one sorted list. The list should be made by splicing together the nodes of the first two lists.
# Return the head of the merged linked list.

# Solution: Soln. 1: time complexity O(L1+L2) and space complexity O(L1+L2). 
#           Soln. 2: 
#           Note: I personally find the brute force solution easier. Don't know if the recursive one works better.


# Soln. 1: With a new LL, brute force
# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def mergeTwoLists(self, l1: ListNode, l2: ListNode) -> ListNode:
        dummy = root = ListNode()      
        while l1 and l2:
            if l1.val > l2.val:
                root.next = ListNode(l2.val)
                l2 = l2.next
            else:
                root.next = ListNode(l1.val)
                l1 = l1.next
            root = root.next
        if l1:
            root.next = l1
        elif l2:
            root.next = l2
        return dummy.next



# Soln. 2: Recursive
# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def mergeTwoLists(self, l1: ListNode, l2: ListNode) -> ListNode:
        if not l1 or not l2:
            return l1 or l2
        if l1.val < l2.val:
            l1.next = self.mergeTwoLists(l1.next, l2)
            return l1
        else:
            l2.next = self.mergeTwoLists(l1, l2.next)
            return l2
       
